# NWIS Backend — Environment Configuration Example
# Copy this file to .env and fill in your actual values.
# NEVER commit the real .env file to version control.

# ────────────────────────────────────────────────
# PostgreSQL Database
# ────────────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql://nwis_user:nwis_password@localhost:5432/nwis_db

# ────────────────────────────────────────────────
# Application
# ────────────────────────────────────────────────
ENVIRONMENT=development
APP_NAME=NWIS Backend
APP_VERSION=1.0.0
DEBUG=true

# ────────────────────────────────────────────────
# CORS / Frontend URL
# ────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ────────────────────────────────────────────────
# (Future) Secret Key for auth tokens
# ────────────────────────────────────────────────
# SECRET_KEY=changeme-in-production
